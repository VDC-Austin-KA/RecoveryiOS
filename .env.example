# Copy to .env (git-ignored), fill in, then run ./scripts/generate_config.sh
# Leave a value empty (or as YOUR_...) to use the built-in offline mock provider.

# --- AI assistant (bring your own key; users can also paste keys in Settings) ---
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# --- Meeting Guide / OMLA JSON feeds (one URL per fellowship) ---
# Spec: https://github.com/code4recovery/spec  e.g. a TSML site's /wp-admin/admin-ajax.php?action=meetings
MEETING_FEED_AA=
MEETING_FEED_NA=
MEETING_FEED_HA=
MEETING_FEED_SMART=
MEETING_FEED_ALANON=
